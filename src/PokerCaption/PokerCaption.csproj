<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Processo x86 per compatibilità con i client a 32 bit -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>PokerCaption</AssemblyName>
    <Product>PokerCaption</Product>
    <ProgramIconScript>$(MSBuildProjectDirectory)\..\..\tools\New-ProgramIcon.ps1</ProgramIconScript>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\PokerCaption.ico</ApplicationIcon>
    <RootNamespace>PokerCaption</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="PokerCaption.ProgramIcon" />
    <!-- DLL native incluse nell'output (x86 per client 32-bit, x64 per 64-bit) -->
    <None Include="..\..\native\bin\x86\captionHook.dll" CopyToOutputDirectory="PreserveNewest" Link="native\x86\captionHook.dll" />
    <None Include="..\..\native\bin\x64\captionHook.dll" CopyToOutputDirectory="PreserveNewest" Link="native\x64\captionHook.dll" />
    <None Include="..\..\native\third_party\minhook\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="native\MinHook-LICENSE.txt" />
    <!-- profilo skin + dump UIA (nick pre-tavolo) -->
    <None Include="..\..\tools\dump_uia.ps1" CopyToOutputDirectory="PreserveNewest" Link="tools\dump_uia.ps1" />
  </ItemGroup>

  <Target Name="GenerateProgramIcon" BeforeTargets="PrepareForBuild"
          Inputs="$(ProgramIconScript)" Outputs="$(ApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProgramIconScript)&quot; -OutputPath &quot;$(ApplicationIcon)&quot;" />
  </Target>

</Project>
